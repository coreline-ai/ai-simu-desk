# Set these in Vercel Project > Settings > Environment Variables, for Production.
APP_MODE=vercel
APP_ORIGIN=https://your-project.vercel.app
DATABASE_URL=postgresql://your_user:your_password@your-pooled-neon-host/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=fake
FAKE_AI_DELAY_MS=65
# Optional: DATABASE_CA for a private CA; public Neon uses system trust roots.
# Never set DATABASE_SSL=disable for a remote deployment.
